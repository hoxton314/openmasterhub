[Unit]
Description=OpenMasterHUB service for the Cooler Master MasterHUB
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/masterhubd
Restart=on-failure
RestartSec=2
# Above the 5 s a stalled module request takes to time out (some distributions default to 10 s).
TimeoutStopSec=30

[Install]
WantedBy=graphical-session.target
