{
  "id": "desktop-media",
  "kind": "profile",
  "name": "Desktop media",
  "about": "Now playing, media keys, launchers, clock",
  "category": "Everyday",
  "needs": [
    "keypad",
    "dial",
    "knob"
  ],
  "profile": {
    "name": "Desktop media",
    "color": "#5B6170",
    "about": "Now playing, media keys, launchers, clock",
    "page": [
      {
        "name": "Main",
        "key": [
          {
            "index": 0,
            "label": "Play",
            "press": {
              "keys": "playpause"
            },
            "background": "#1e5ac8"
          },
          {
            "index": 1,
            "label": "Prev",
            "press": {
              "keys": "previoussong"
            },
            "background": "#283c64"
          },
          {
            "index": 2,
            "label": "Next",
            "press": {
              "keys": "nextsong"
            },
            "background": "#283c64"
          },
          {
            "index": 3,
            "widget": {
              "kind": "clock"
            }
          },
          {
            "index": 4,
            "label": "Mute",
            "press": {
              "mute": "toggle"
            },
            "background": "#c81e1e"
          },
          {
            "index": 5,
            "widget": {
              "kind": "cpu_usage"
            }
          },
          {
            "index": 6,
            "widget": {
              "kind": "gpu_usage"
            }
          },
          {
            "index": 7,
            "widget": {
              "kind": "ram_usage"
            }
          },
          {
            "index": 10,
            "widget": {
              "kind": "now_playing"
            }
          }
        ]
      }
    ],
    "dial": {
      "widget": {
        "kind": "volume"
      },
      "cw": {
        "volume": "+2"
      },
      "ccw": {
        "volume": "-2"
      },
      "press": {
        "mute": "toggle"
      }
    },
    "knob": [
      {
        "index": 2,
        "cw": {
          "keys": "volumeup"
        },
        "ccw": {
          "keys": "volumedown"
        },
        "press": {
          "keys": "mute"
        }
      }
    ]
  }
}
