{
  "$schema": "./theme.schema.json",
  "schemaVersion": 1,
  "id": "dark",
  "name": "Dark",
  "author": "OpenMasterHUB",
  "version": "1.0.0",
  "description": "Quiet graphite panels with an indigo accent. The complete base theme.",
  "appearance": "dark",
  "followsSystem": true,
  "density": "compact",
  "tokens": {
    "color": {
      "bg": "#0E0F12",
      "surface": "#15171B",
      "raised": "#1E2026",
      "sunken": "#0A0B0D",
      "border": "#2A2D34",
      "border2": "#3B3F48",
      "text1": "#ECEDF0",
      "text2": "#A6AAB4",
      "text3": "#80858F",
      "accent": "#8B90FF",
      "accentFill": "#5E63EB",
      "onAccent": "#FFFFFF",
      "focus": "#A5A9FF",
      "success": "#3DD68C",
      "warning": "#F2B84B",
      "danger": "#FF7070",
      "onDanger": "#FFFFFF",
      "selection": "rgba(139,144,255,0.14)",
      "canvas": "#08090B",
      "canvasDot": "#16181D",
      "overlay": "rgba(4,5,8,0.66)",
      "claim": "#F2D24B",
      "markerBg": "#F3F4F6",
      "markerFg": "#0B0C0E",
      "pressed": "#FFFFFF",
      "chip": "#22252C",
      "rail": "{color.bg}",
      "dialog": "{color.raised}",
      "onAvatar": "#FFFFFF"
    },
    "font": {
      "ui": "'Inter Variable', Inter, system-ui, sans-serif",
      "heading": "'Inter Variable', Inter, system-ui, sans-serif",
      "mono": "'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace"
    },
    "type": {
      "display": { "family": "heading", "size": 28, "lineHeight": 1.2, "weight": 700, "case": "none", "tracking": 0 },
      "title": { "family": "heading", "size": 22, "lineHeight": 1.2, "weight": 600, "case": "none", "tracking": 0 },
      "heading": { "family": "heading", "size": 18, "lineHeight": 1.25, "weight": 600, "case": "none", "tracking": 0 },
      "section": { "family": "heading", "size": 15, "lineHeight": 1.3, "weight": 600, "case": "none", "tracking": 0 },
      "body": { "family": "ui", "size": 13, "lineHeight": 1.45, "weight": 400, "case": "none", "tracking": 0 },
      "small": { "family": "ui", "size": 12, "lineHeight": 1.4, "weight": 400, "case": "none", "tracking": 0 },
      "label": { "family": "ui", "size": 11, "lineHeight": 1.3, "weight": 600, "case": "uppercase", "tracking": 0.06, "color": "text3" },
      "mono": { "family": "mono", "size": 12, "lineHeight": 1.4, "weight": 400, "case": "none", "tracking": 0 },
      "tree": { "family": "ui", "size": 12.5, "lineHeight": 1.3, "weight": 400, "case": "none", "tracking": 0 },
      "chip": { "family": "ui", "size": 11.5, "lineHeight": 1.2, "weight": 500, "case": "none", "tracking": 0 },
      "micro": { "family": "ui", "size": 10, "lineHeight": 1.2, "weight": 500, "case": "none", "tracking": 0 }
    },
    "radius": {
      "xs": 4, "sm": 6, "md": 8, "lg": 10, "xl": 14, "pill": 999,
      "control": 7, "segment": 5, "kbd": 5, "row": 6, "sidebarRow": 7, "chip": 999, "avatar": 6,
      "rail": 8, "card": 12, "panel": 9, "toast": 10, "popover": 10, "dialog": 14, "well": 10
    },
    "shadow": {
      "flat": "none",
      "hairline": "0 0 0 1px {color.border}",
      "popover": "0 12px 32px rgba(0,0,0,0.50), 0 0 0 1px {color.border}",
      "dialog": "{shadow.popover}",
      "segment": "0 1px 2px rgba(0,0,0,0.25), 0 0 0 1px {color.border}",
      "kbd": "0 1px 0 {color.border2}"
    },
    "focus": { "width": 2, "offset": 2, "color": "{color.focus}" },
    "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "7": 32, "8": 40 },
    "size": {
      "rail": 64, "sidebar": 236, "sidebarCollapsed": 52, "inspector": 344, "inspectorNarrow": 320, "topbar": 52,
      "panelPad": 16, "control": 32, "controlSm": 28, "segment": 26, "chip": 22, "rowSidebar": 32, "rowTree": 28,
      "avatar": 20, "toggleWidth": 34, "toggleHeight": 20, "kbd": 24, "iconButton": 30, "dialogWidth": 420, "dialogBorder": 0
    },
    "motion": {
      "fast": "120ms ease-out",
      "panel": "180ms cubic-bezier(.2,.8,.2,1)",
      "toastIn": "200ms cubic-bezier(.2,.8,.2,1)",
      "toastOut": "150ms ease-in",
      "keyFlash": "120ms ease-out",
      "appliedPulse": "600ms ease-out"
    },
    "style": {
      "headingCase": "none",
      "selectedRow": "tint",
      "panelBorderWidth": 1,
      "buttonWeight": 500,
      "secondaryButton": "raised",
      "dangerButton": "outline",
      "segmentSelected": "raised",
      "toggleOff": "fill",
      "kbd": "raised",
      "statusChip": "tint",
      "activeItem": "tint",
      "fieldBorder": "hairline"
    },
    "avatar": {
      "1": "#C26A2B", "2": "#3F7FB5", "3": "#5960D6", "4": "#7655C7", "5": "#B5634A", "6": "#2F8F66", "7": "#5B6170"
    },
    "hub": {
      "base": "#17181B",
      "baseStroke": "#2B2D33",
      "chassis": "#0F1012",
      "chassisStroke": "#26282E",
      "key": "#24272D",
      "empty": "#101114",
      "socket": "rgba(255,255,255,0.025)",
      "keyText": "#E8EAEE",
      "keyEdge": "#000000",
      "dialFace": "#0B0C0E",
      "dialCaption": "#9AA0AA",
      "dialRing1": "#3A3D44",
      "dialRing2": "#1E2024",
      "knobLight": "#3A3D44",
      "knobDark": "#15161A",
      "knobMark": "#C8CCD4",
      "rollerLight": "#34373E",
      "rollerDark": "#17181C",
      "caption": "#8C919B",
      "brand": "#5A5E68",
      "logo": "#C8CCD4",
      "keyFrame": "0 0 0 1px {hub.keyEdge}, 0 0 0 2px {hub.chassisStroke}",
      "previewFrame": "0 0 0 1px {hub.keyEdge}, 0 0 0 3px {hub.chassisStroke}",
      "chassisShadow": "inset 0 0 0 1px {hub.chassisStroke}, 0 2px 0 rgba(0,0,0,0.4)",
      "baseShadow": "inset 0 0 0 1px {hub.baseStroke}, 0 24px 48px rgba(0,0,0,0.45)",
      "dialBezel": "0 0 0 14px {hub.dialRing2}, 0 0 0 16px {hub.dialRing1}",
      "rollerShadow": "inset 0 6px 8px rgba(0,0,0,0.6), inset 0 -6px 8px rgba(0,0,0,0.6)",
      "keyRadius": 4,
      "chassisRadius": 9,
      "baseRadius": 16,
      "rollerRadius": 6
    }
  }
}
